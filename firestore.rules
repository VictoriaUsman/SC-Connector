rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jobs: allow read for real-time dashboard, deny client writes
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if false;
    }

    // Clients: allow read for UI dropdowns
    match /clients/{clientId} {
      allow read: if true;
      allow write: if false;
    }

    // Schedules: allow read for schedule management UI
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
