# Kalilos Amazon Reports Connector — Environment Configuration
# Copy this file to .env.staging or .env.prod and fill in the values.

# --- GCP ---
# Required GCP account — all scripts verify this before running
GCP_ACCOUNT=niv@kalilos.com

# The GCP project ID for this environment
GCP_PROJECT=kalilos-connector-{env}

# The GCP region for all resources
GCP_REGION=us-central1

# --- Firebase ---
# Firebase project ID (typically the same as GCP_PROJECT)
FIREBASE_PROJECT=kalilos-connector-{env}

# --- Pulumi ---
# Pulumi stack name (must match the environment: "staging" or "prod")
PULUMI_STACK={env}

# --- Google Drive ---
# Root folder ID in Google Drive where reports are stored
# Create this folder manually and share it with the service account
GDRIVE_ROOT_FOLDER_ID=<root folder ID for this env>

# --- API Gateway ---
# Base URL for the API Gateway serving the frontend API
API_GATEWAY_URL=https://{env}-api.kalilos.com

# --- Amazon Credentials (local development only) ---
# In deployed environments, these are stored in GCP Secret Manager.
# Uncomment for local testing:
# LWA_CLIENT_ID=
# LWA_CLIENT_SECRET=
# ADS_API_CLIENT_ID=
# ADS_API_CLIENT_SECRET=
